{
  "name": "bb-plugin-pr-link",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Shows a pull request icon in the thread header when a PR is mentioned in chat, linking to it on Delta or GitHub.",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "PR Link",
    "description": "When a pull request is mentioned in a thread's chat, shows a PR icon in the thread header that opens it on Delta (shop/world) or GitHub.",
    "branding": {
      "icon": "GitPullRequest"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts && vitest run"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^28.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "zod": "^4.6.5"
  },
  "license": "MIT"
}